{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "seichigo-anitabi-mirror",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-14",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "@prisma/client/wasm": "../../node_modules/@prisma/client/wasm.js"
  },
  "triggers": {
    "crons": ["*/5 * * * *", "0 * * * *", "15 3 * * *"]
  },
  "vars": {
    "MAP_IMAGE_MIRROR_CRON_ENABLED": "1",
    "SEICHIGO_ORIGIN": "https://seichigo.com"
  },
  "secrets": {
    "required": ["DATABASE_URL", "ANITABI_CRON_SECRET", "OPS_CRON_SECRET"]
  },
  "r2_buckets": [
    { "binding": "MAP_IMAGE_CACHE", "bucket_name": "seichigo-anitabi-images" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
